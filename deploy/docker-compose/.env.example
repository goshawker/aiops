# AIOps Platform Environment Variables

# JWT
JWT_SECRET=change-me-in-production

# VictoriaMetrics
VM_RETENTION=30d

# ClickHouse
CLICKHOUSE_DB=aiops
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092

# Service ports
GATEWAY_PORT=8080
QUERY_PORT=8081
ALERT_PORT=8082
ADMIN_PORT=8083
COLLECTOR_PORT=8084
JOB_PORT=8085

# AI Services
ANOMALY_PORT=5001
RCA_PORT=5002
ALERT_AGG_PORT=5003
LLM_PORT=5004

# Web
WEB_PORT=3000

# Log level
LOG_LEVEL=info
